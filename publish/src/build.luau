--!strict
-- `rbxm-publish build` (spec §5.2): generates a Rojo project wrapping each container in a
-- `RbxmDeliveryBuild` folder (spec §4.1), builds it, and writes managed.rbxm + build.json.

local crypto = require("@lute/crypto")
local fs = require("@std/fs")
local json = require("@std/json")
local pathlib = require("@std/path")
local process = require("@std/process")

local config = require("./config")
local manifest = require("./manifest")
local paths = require("./paths")
local resolve = require("./resolve")

-- Written next to the source project so its relative `$path`s and `globIgnorePaths` keep
-- working unchanged. Removed after the build.
local GENERATED_PROJECT_NAME = ".rbxm-publish.tmp.project.json"
local GENERATED_BUILD_INFO_NAME = ".rbxm-publish.tmp.BuildInfo.luau"
local ROOT_NAME = "RbxmDeliveryBuild"

export type Options = {
	configPath: string,
	outDir: string,
	-- Override the commit and ref; otherwise taken from GITHUB_SHA/GITHUB_REF, then git.
	commit: string?,
	ref: string?,
}

export type BuildInfo = { commit: string, ref: string, builtAt: string }

local build = {}

local function git(args: { string }, cwd: string): string?
	local command = { "git" }
	for _, arg in args do
		table.insert(command, arg)
	end
	local dir: string = if cwd == "" then "." else cwd
	local ok, result = pcall(function()
		return process.run(command, { cwd = dir })
	end)
	if not ok or not result.ok then
		return nil
	end
	local output = string.gsub(result.stdout, "%s+$", "")
	return if output == "" then nil else output
end

function build.sourceInfo(options: Options, cwd: string): (string, string)
	local commit = options.commit or process.env.GITHUB_SHA or git({ "rev-parse", "HEAD" }, cwd)
	if commit == nil then
		error("can't determine the commit: not in a git repository? Pass --commit", 0)
	end
	if not string.match(commit, "^%x+$") or (#commit ~= 40 and #commit ~= 64) then
		error(`commit '{commit}' is not a full git object id`, 0)
	end
	commit = string.lower(commit)

	local ref = options.ref or process.env.GITHUB_REF or git({ "symbolic-ref", "-q", "HEAD" }, cwd)
	if ref == nil then
		error("can't determine the ref (detached HEAD?). Pass --ref, e.g. --ref refs/heads/main", 0)
	end
	if string.sub(ref, 1, 5) ~= "refs/" then
		error(`ref '{ref}' must be a full ref name, e.g. refs/heads/main`, 0)
	end
	return commit, ref
end

function build.buildInfoSource(info: BuildInfo): string
	return table.concat({
		"-- Generated by rbxm-publish. Do not edit.",
		"return table.freeze({",
		`\tcommit = {string.format("%q", info.commit)},`,
		`\tref = {string.format("%q", info.ref)},`,
		`\tbuiltAt = {string.format("%q", info.builtAt)},`,
		"})",
		"",
	}, "\n")
end

-- Escapes glob metacharacters so a literal path can be used in globIgnorePaths.
local function globEscape(path: string): string
	return (string.gsub(path, "[%*%?%[%]{}]", "[%0]"))
end

-- Places the BuildInfo ModuleScript (at `modulePath`, sourced from `sourceFile`) into the
-- generated project. Its parent must be a container or an explicit node inside one; any file
-- the project already has at that path (e.g. a committed placeholder) is ignored.
function build.addBuildInfo(
	generated: json.Object,
	projectDir: string,
	containers: { { string } },
	modulePath: string,
	sourceFile: string
)
	local segments = paths.split(modulePath)
	local container: { string }? = nil
	for _, candidate in containers do
		if #candidate < #segments and paths.isPrefix(candidate, segments) then
			container = candidate
			break
		end
	end
	if container == nil then
		error(`buildInfoModule '{modulePath}' must be inside one of the containers`, 0)
	end

	local tree = json.asObject(generated.tree) :: json.Object
	local node = json.asObject(tree[table.concat(container, "/")]) :: json.Object
	for i = #container + 1, #segments - 1 do
		local child = node[segments[i]]
		local childNode = if child == nil then nil else json.asObject(child)
		if childNode == nil then
			error(
				`buildInfoModule '{modulePath}': '{segments[i]}' must be an explicit node in the project `
					.. "(or put the module directly in a container)",
				0
			)
		end
		node = childNode
	end

	local leaf = segments[#segments]
	if node[leaf] ~= nil then
		error(`buildInfoModule '{modulePath}' collides with a node of that name in the project`, 0)
	end

	local dirPath = resolve.nodePath(node)
	if dirPath then
		local dir = pathlib.format(pathlib.join(projectDir, dirPath))
		if fs.exists(dir) and fs.type(dir) == "dir" then
			local existing: json.Value = generated.globIgnorePaths
			local ignores: json.Array = json.asArray(existing) or {}
			for _, entry in resolve.matchingEntries(dir, leaf) do
				local relative = string.gsub(resolve.joinRelative(dirPath, entry.name), "^%./", "")
				table.insert(ignores, globEscape(relative))
				if entry.isDirectory then
					table.insert(ignores, globEscape(relative) .. "/**")
				end
			end
			if #ignores > 0 then
				generated.globIgnorePaths = ignores
			end
		end
	end

	node[leaf] = json.object({ ["$path"] = sourceFile })
end

-- Builds the generated project description (without writing anything).
function build.generateProject(cfg: config.Config, containers: { { string } }): (json.Object, string)
	if not fs.exists(cfg.project) then
		error(`Rojo project '{cfg.project}' not found`, 0)
	end
	local ok, decoded = pcall(json.deserialize, fs.readFileToString(cfg.project))
	local project = if ok then json.asObject(decoded) else nil
	local tree = if project then json.asObject(project.tree) else nil
	if project == nil or tree == nil then
		error(`'{cfg.project}' is not a Rojo project (expected a JSON object with a 'tree')`, 0)
	end

	local projectDir = pathlib.dirname(cfg.project)
	local generatedTree = json.object({ ["$className"] = "Folder" })
	-- Keep project-wide settings (globIgnorePaths, emitLegacyScripts, syncRules, ...).
	local generated = json.object({})
	for key, value in project do
		if typeof(key) == "string" and key ~= "name" and key ~= "tree" then
			generated[key] = value
		end
	end
	generated.name = ROOT_NAME
	generated.tree = generatedTree

	for i, segments in containers do
		generatedTree[cfg.containers[i]] = resolve.container(projectDir, tree, segments)
	end
	return generated, projectDir
end

function build.run(options: Options): manifest.Manifest
	local cfg = config.load(options.configPath)
	local containers = paths.checkContainers(cfg.containers)
	local generated, projectDir = build.generateProject(cfg, containers)

	local commit, ref = build.sourceInfo(options, pathlib.dirname(options.configPath))
	local builtAt = os.date("!%Y-%m-%dT%H:%M:%SZ")

	if not fs.exists(options.outDir) then
		fs.createDirectory(options.outDir, { makeParents = true })
	end
	local outDir = pathlib.resolve(options.outDir)
	local rbxmPath = pathlib.format(pathlib.join(outDir, manifest.ARTIFACT_NAME))
	local manifestPath = pathlib.format(pathlib.join(outDir, manifest.MANIFEST_NAME))
	local projectPath = pathlib.format(pathlib.join(projectDir, GENERATED_PROJECT_NAME))
	local buildInfoPath = pathlib.format(pathlib.join(outDir, GENERATED_BUILD_INFO_NAME))

	-- Don't leave a stale build behind if this one fails.
	for _, stale in { rbxmPath, manifestPath } do
		if fs.exists(stale) then
			fs.remove(stale)
		end
	end

	local temporary = { projectPath }
	if cfg.buildInfoModule then
		build.addBuildInfo(generated, projectDir, containers, cfg.buildInfoModule, buildInfoPath)
		fs.writeStringToFile(buildInfoPath, build.buildInfoSource({ commit = commit, ref = ref, builtAt = builtAt }))
		table.insert(temporary, buildInfoPath)
	end

	fs.writeStringToFile(projectPath, json.serialize(generated, true))
	local ok, result = pcall(function()
		return process.run({ "rojo", "build", projectPath, "--output", rbxmPath })
	end)
	for _, file in temporary do
		if fs.exists(file) then
			fs.remove(file)
		end
	end
	if not ok then
		error(`couldn't run rojo (is it installed and on PATH?): {result}`, 0)
	end
	if not result.ok then
		error(`rojo build failed:\n{result.stderr}{result.stdout}`, 0)
	end

	local artifact = fs.readFileToString(rbxmPath)
	local m: manifest.Manifest = {
		schemaVersion = manifest.SCHEMA_VERSION,
		commit = commit,
		ref = ref,
		builtAt = builtAt,
		artifact = {
			size = #artifact,
			sha256 = manifest.hex(crypto.digest(crypto.hash.sha256, artifact)),
		},
		containers = cfg.containers,
	}
	fs.writeStringToFile(manifestPath, manifest.encode(m))
	return m
end

return build
