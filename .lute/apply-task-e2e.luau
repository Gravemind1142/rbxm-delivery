--!strict
-- lute apply-task-e2e [--cloud]: run apply-task.luau the way a consumer does. Builds the bundle
-- and the fixture build, joins the bundle and a small driver into one script (a task runs one
-- script source) and runs it with studio-run, passing the build as task inputs. It applies the
-- fixture build to the test place and never saves it.
--
-- Locally it needs Windows or macOS with Roblox Studio. With --cloud (or
-- STUDIO_RUN_HOST=cloud) it runs as an Open Cloud Luau Execution task, which needs
-- ROBLOX_API_KEY, ROBLOX_UNIVERSE_ID and ROBLOX_PLACE_ID; CI runs it weekly.
local fs = require("@std/fs")
local pathlib = require("@std/path")
local process = require("@std/process")
local task = require("./_lib/task")

local cloud = process.env.STUDIO_RUN_HOST == "cloud"
for _, arg in task.args(...) do
	if arg == "--cloud" then
		cloud = true
	else
		print("usage: lute apply-task-e2e [--cloud]")
		process.exit(2)
	end
end

task.must({ task.lute, "build-apply-task" })
task.must({
	task.lute,
	"publish/src/main.luau",
	"build",
	"--config",
	"publish/tests/fixtures/game/rbxm-publish.json",
	"--out",
	"build/pull-fixture",
	"--commit",
	string.rep("f", 40),
	"--ref",
	"refs/heads/main",
})
-- The same check a pipeline runs before creating the task.
task.must({
	task.lute,
	"publish/src/main.luau",
	"verify",
	"--dir",
	"build/pull-fixture",
	"--allowed-ref",
	"refs/heads/main",
})

local bundle = fs.readFileToString(pathlib.format(pathlib.join(task.root, "build", "apply-task.luau")))
local script = table.concat({
	"--!native",
	"-- Generated by `lute apply-task-e2e`: apply-task.luau wrapped as a consumer would, plus a driver.",
	"local ctx = ...",
	"local applyTask = (function()",
	bundle,
	"end)()",
	"",
	"local outcome = applyTask({",
	'\tinputs = { ["managed.rbxm"] = ctx.inputs.managed, ["build.json"] = ctx.inputs.manifest },',
	'\targs = { allowedRef = "refs/heads/main" },',
	"\tlog = print,",
	"})",
	"print(`apply-task-e2e: ok={outcome.ok} summary={outcome.summary}`)",
	"if not outcome.ok then",
	"\treturn false",
	"end",
	'local marker = game:GetService("ServerStorage"):FindFirstChild("RbxmPull")',
	'if marker == nil or marker:GetAttribute("Commit") ~= outcome.record.commit then',
	'\tprint("apply-task-e2e: the marker doesn\'t record the applied commit")',
	"\treturn false",
	"end",
	"-- A real pipeline would save the place here.",
	"return true",
	"",
}, "\n")
fs.writeStringToFile(pathlib.format(pathlib.join(task.root, "build", "apply-task-e2e.luau")), script)

local command = {
	"studio-run",
	"run",
	"build/apply-task-e2e.luau",
	"--input",
	"managed=build/pull-fixture/managed.rbxm",
	"--input",
	"manifest=build/pull-fixture/build.json",
}
if cloud then
	for _, name in { "ROBLOX_API_KEY", "ROBLOX_UNIVERSE_ID", "ROBLOX_PLACE_ID" } do
		if (process.env[name] or "") == "" then
			print(`apply-task-e2e --cloud: set {name}`)
			process.exit(2)
		end
	end
	for _, arg in
		{
			"--cloud",
			"--universe-id",
			process.env.ROBLOX_UNIVERSE_ID :: string,
			"--place-id",
			process.env.ROBLOX_PLACE_ID :: string,
		}
	do
		table.insert(command, arg)
	end
end
task.must(command)
