--!strict
-- Bundles pull/src/Apply into one Luau file with no requires, for hosts that run a single
-- script source (Open Cloud Luau Execution tasks). Used by `lute build-apply-task` and by the
-- mock tests in pull/mock-tests.
--
-- Not a general bundler: Apply's modules only require each other as `require(script.Name)`
-- (from init.luau) or `require(script.Parent)` (from Task.luau). Each module becomes a local
-- function result, in dependency order; `export type` becomes a local `type`. The result
-- fails the build if any require or `script` reference is left.

local fs = require("@std/fs")
local luau = require("@std/luau")
local pathlib = require("@std/path")

local bundle = {}

-- Dependency order: each module only requires modules above it.
local MODULES = {
	{ name = "Sha256", file = "Sha256.luau" },
	{ name = "Paths", file = "Paths.luau" },
	{ name = "Marker", file = "Marker.luau" },
	{ name = "Manifest", file = "Manifest.luau" },
	{ name = "Apply", file = "init.luau" },
	{ name = "Task", file = "Task.luau" },
}

local VERSION_LINE = 'local VERSION = "dev" -- replaced by lute build-apply-task'

export type Entry = "Apply" | "Task"

local function local_(name: string): string
	return `__{name}`
end

-- Code with `--` comments removed, to look for leftover references. Apply's code has no `--`
-- inside strings, which this would cut short.
local function code(source: string): string
	local lines = {}
	for _, line in string.split(source, "\n") do
		table.insert(lines, (string.gsub(line, "%-%-.*$", "")))
	end
	return table.concat(lines, "\n")
end

local function transform(name: string, source: string, version: string): string
	local lines = {}
	for _, line in string.split(string.gsub(source, "\r\n", "\n"), "\n") do
		if string.match(line, "^%-%-!%a+") then
			continue -- directives only work at the top of the file; the bundle sets its own
		end
		line = string.gsub(line, "^export type ", "type ")
		line = string.gsub(line, "require%(script%.Parent%)", local_("Apply"))
		line = string.gsub(line, "require%(script%.(%w+)%)", function(child: string)
			return local_(child)
		end)
		if line == VERSION_LINE then
			line = `local VERSION = "{version}"`
		end
		table.insert(lines, line)
	end
	local out = table.concat(lines, "\n")

	local stripped = code(out)
	if string.find(stripped, "require%s*%(") or string.find(stripped, "%f[%w_]script%f[^%w_]") then
		error(`bundle: {name} still has a require or a script reference after bundling`, 0)
	end
	if name == "Task" and not string.find(out, `local VERSION = "{version}"`, 1, true) then
		error(`bundle: Task.luau has no '{VERSION_LINE}' line to stamp the version on`, 0)
	end
	return out
end

-- Returns the bundled source of `entry` ("Apply" returns the Apply module; "Task" returns
-- apply-task.luau's function), built from `root`/pull/src/Apply.
function bundle.build(root: string, entry: Entry, version: string): string
	local dir = pathlib.join(root, "pull", "src", "Apply")
	local parts = {
		"--!native",
		"--!nocheck",
		if entry == "Task"
			then `-- apply-task.luau {version}: applies an rbxm-delivery build in an Open Cloud Luau Execution task.`
			else `-- Apply.luau {version}: rbxm-delivery's Apply module in one file.`,
		"-- Generated by `lute build-apply-task` from pull/src/Apply; don't edit. See docs/spec.md §7.",
		"-- https://github.com/Gravemind1142/rbxm-delivery",
		"",
	}
	for _, module in MODULES do
		local source = fs.readFileToString(pathlib.format(pathlib.join(dir, module.file)))
		table.insert(parts, `local {local_(module.name)} = (function()`)
		table.insert(parts, transform(module.name, source, version))
		table.insert(parts, "end)()")
		table.insert(parts, "")
		if module.name == entry then
			break
		end
	end
	table.insert(parts, `return {local_(entry)}`)
	local out = table.concat(parts, "\n") .. "\n"

	-- Make sure it parses; the bundle is never type checked.
	local ok, err = pcall(function()
		luau.load(luau.compile(out), entry)
	end)
	if not ok then
		error(`bundle: the bundled {entry} doesn't compile: {err}`, 0)
	end
	return out
end

-- The release version, from pull/wally.toml (the release workflow checks it matches the tag).
function bundle.version(root: string): string
	local toml = fs.readFileToString(pathlib.format(pathlib.join(root, "pull", "wally.toml")))
	local version = string.match(toml, '\nversion%s*=%s*"([^"]+)"')
	if version == nil then
		error("bundle: no version in pull/wally.toml", 0)
	end
	return version
end

return bundle
